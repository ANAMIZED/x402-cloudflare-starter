# ===========================================
# Receiving wallet addresses (Mainnet)
# ===========================================
# These should be set as Cloudflare Worker secrets:
#
#   npx wrangler secret put BASE_ADDRESS
#   npx wrangler secret put SOLANA_ADDRESS
#
# Never commit real private keys.

BASE_ADDRESS=0xYourBaseAddressHere
SOLANA_ADDRESS=YourSolanaAddressHere

# ===========================================
# Optional: for the test client only
# ===========================================
# EVM_PRIVATE_KEY=0x...
# SVM_PRIVATE_KEY=...   # base58
